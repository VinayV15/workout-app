# The Supabase project this deployment syncs against.
#
# Committed on purpose. Without it a new device — a fresh browser, or the iOS
# home-screen app, which gets storage separate from the Safari tab it was added
# from — cannot know which project to talk to, so signing in is impossible until
# the URL and key are pasted into Settings by hand. Baking them in makes a new
# device a sign-in rather than a re-setup.
#
# The anon key is designed to be public and ends up in the built JS either way.
# Row-level security is the protection: every row is scoped to auth.uid(), so a
# signed-in user can only ever read their own. The service_role key must never
# appear here or anywhere else in this repo — it bypasses that entirely.
#
# A repository variable of the same name overrides this, so a fork can point at
# its own project without editing the file.
VITE_SUPABASE_URL=https://frdqljsqctksbzlrsggw.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZyZHFsanNxY3Rrc2J6bHJzZ2d3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODU0NTY4MTIsImV4cCI6MjEwMTAzMjgxMn0.NmTb8d4mKrzK6uAXgXaM--w9R73__05FhxqlGMVn19c
